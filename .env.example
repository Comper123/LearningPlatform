# --- Supabase Postgres -------------------------------------------------
# Session pooler / direct connection из Supabase → Project Settings → Database
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- NextAuth ----------------------------------------------------------
# сгенерировать: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Кто может стать преподавателем ------------------------------------
# Два независимых ключа, достаточно любого.
#
# 1) Адреса преподавателей через запятую: такой аккаунт получает роль
#    преподавателя сразу, без ввода кода. Впишите сюда свой адрес.
TEACHER_EMAILS=""
#
# 2) Секретный ключ регистрации преподавателя. Пусто — этот путь закрыт,
#    и роль выдаётся только по списку выше.
TEACHER_SIGNUP_CODE=""

# --- Supabase Storage (вложения к домашним заданиям) --------------------
# Необязательно: без этих переменных ученик сдаёт работу ссылкой или кодом,
# а вкладка «Файл» просто не показывается.
#
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# service_role, НЕ anon. Ключ секретный и используется только на сервере.
SUPABASE_SERVICE_ROLE_KEY=""
# Имя приватного бакета, по умолчанию "submissions"
SUPABASE_BUCKET="submissions"
